  "devDependencies": {
    "@buzz/author": "file:vendor/buzz-author-0.0.0-preview.1.tgz",
    "@playwright/test": "1.65.0",
    "@types/node": "22.19.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3"
  }
}
